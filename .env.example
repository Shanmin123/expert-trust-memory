# Copy this file to ".env" and fill in real values. ".env" is gitignored and is
# loaded automatically by the experiment launcher (data_collection.config.load_env_file).
# NEVER commit ".env"; NEVER put a real key in THIS example file.
# Precedence: an already-exported shell var wins over .env (os.environ.setdefault),
# so `set OPENAI_API_KEY=...` still overrides the file for a one-off run.

# OpenAI API key for the expert / news-sentiment / reflection LLM backends.
OPENAI_API_KEY=sk-...your-key-here...

IB_HOST=127.0.0.1
# IB Gateway paper trading commonly listens on 4002.
# TWS paper trading commonly listens on 7497.
IB_PORT=4002
IB_CLIENT_ID=1

DATA_DIR=data
REPORTS_DIR=reports
